# ─── Public site settings ────────────────────────────────────────────────
# Canonical production URL (used for sitemap, robots, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.localimpactdoorstep.com

# Optional public contact details. Leave blank to hide them on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Optional confirmed service area, e.g. "Nashville, TN and surrounding communities".
# Leave blank until confirmed; the site then shows neutral "select local markets" copy.
NEXT_PUBLIC_SERVICE_AREA=

# ─── Quote form delivery (configure at least one in production) ──────────
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
# Where quote requests are sent (comma-separate multiple addresses).
QUOTE_TO_EMAIL=
# Verified sender, e.g. "Local Impact Doorstep <quotes@yourdomain.com>".
QUOTE_FROM_EMAIL=

# Option B: POST each request as JSON to a webhook (Zapier, Make, Slack, CRM…).
QUOTE_WEBHOOK_URL=

# If neither option is configured, production submissions return an error so no
# lead is silently lost. Set to "true" to accept them and only write to server logs.
QUOTE_ALLOW_LOG_ONLY=
